{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": []
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods",
    "build",
    // Build tooling runs under Bun, not React Native, and uses Bun and
    // node: APIs this config deliberately does not provide.
    "scripts"
  ]
}